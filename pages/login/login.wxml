<view class="container">
  <view class="form-item">
    <label>用户名：</label>
    <input type="text" placeholder="请输入用户名" bindinput="handleInput" data-field="username" />
  </view>
  <view class="form-item">
    <label>密码：</label>
    <input type="password" placeholder="请输入密码" bindinput="handleInput" data-field="password" />
  </view>
  <view class="form-item">
    <label>确认密码：</label>
    <input type="password" placeholder="请再次输入密码" bindinput="handleInput" data-field="confirmPassword" />
  </view>
  <view class="form-item">
    <label>手机号：</label>
    <input type="number" placeholder="请输入手机号" bindinput="handlePhoneInput" data-field="phone" />
  </view>
  <view class="form-item">
    <label>邮箱：</label>
    <input type="email" placeholder="请输入邮箱" bindinput="handleInput" data-field="email" />
  </view>
  <button bindtap="handleSubmit">注册</button>
</view>